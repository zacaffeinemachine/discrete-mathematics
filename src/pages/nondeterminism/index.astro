---
import Base from "../../layouts/Base.astro";
import { isChapterVisible, isPageVisible } from "../../config/visibility";

const chapter = "nondeterminism";
const chapterTitle = "NFA";
const base = import.meta.env.BASE_URL;

const pages = import.meta.glob("./*.mdx", { eager: true }) as Record<
  string,
  { frontmatter?: { title?: string; order?: number; blurb?: string } }
>;

const subpages = Object.entries(pages)
  .map(([path, mod]) => ({
    slug: path.replace(/^\.\//, "").replace(/\.mdx$/, ""),
    title: mod.frontmatter?.title ?? "",
    order: mod.frontmatter?.order ?? 0,
    blurb: mod.frontmatter?.blurb ?? "",
  }))
  .filter((p) => isPageVisible(chapter, p.slug))
  .sort((a, b) => a.order - b.order);

const released = isChapterVisible(chapter);
---

<Base
  title={chapterTitle}
  description="Nondeterministic finite automata: watch one guess, then design your own and check it."
>
  {
    !released ? (
      <div class="text-center py-24">
        <h1 class="display text-3xl font-bold tracking-tight mb-3">Not yet released</h1>
        <p class="text-[var(--muted)]">
          This chapter isn't available yet. Check back later, or
          <a href={base + "/"} class="underline ml-1" style="color: var(--accent)">
            return to the home page
          </a>.
        </p>
      </div>
    ) : (
      <>
        <nav class="chapter-nav text-sm mb-8" aria-label="Breadcrumb">
          <a href={base + "/"}>Chapters</a>
          <span class="mx-2 text-[var(--faint)]">·</span>
          <span class="text-[var(--ink)]">{chapterTitle}</span>
        </nav>

        <h1 class="display text-3xl font-bold tracking-tight mb-3">{chapterTitle}</h1>
        <p class="text-[var(--muted)] max-w-2xl leading-relaxed mb-10">
          In a nondeterministic machine a state may have several arrows for the same
          symbol, or none at all. The machine accepts a string if at least one way of
          reading it ends in an accepting state. The first page has machines from the
          notes already drawn, so you can watch every way of reading a string at once.
          The other pages are <em>design problems</em>. Each has a canvas under it on
          which you can draw a nondeterministic machine, run it on any string, and check it.
        </p>

        <ol class="space-y-3">
          {subpages.map((p, i) => (
            <li>
              <a
                href={`${base}/${chapter}/${p.slug}`}
                class="flex gap-4 p-4 rounded-lg border border-[var(--rule)] bg-[var(--surface)] hover:border-[var(--accent)] transition-colors"
              >
                <span class="text-[var(--muted)] tabular-nums text-sm pt-0.5">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span>
                  <span class="display font-bold block mb-1">{p.title}</span>
                  <span class="text-sm text-[var(--muted)] leading-relaxed">{p.blurb}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </>
    )
  }
</Base>
