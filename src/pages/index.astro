---
import Base from "../layouts/Base.astro";
import Petersen from "../components/Petersen.astro";
import ChapterCard from "../components/ChapterCard.astro";
import { isChapterVisible } from "../config/visibility";
import {
  COURSE_NAME,
  COURSE_SUBTITLE,
  INSTRUCTOR,
  TEACHING_FELLOWS,
  TEACHING_ASSISTANTS,
  OFFICE,
  BOOKING_URL,
} from "../config/course";

const base = import.meta.env.BASE_URL;

// Hand-curated: the order and the blurbs are pedagogical choices, so this
// one list stays written out rather than globbed.
const allChapters = [
  {
    slug: "induction",
    title: "Puzzles from Induction",
    blurb:
      "Four puzzles you can play. Each one is solved in the book by hunting the smallest case that goes wrong — here you can push the pieces around first.",
  },
];

const chapters = allChapters.filter((c) => isChapterVisible(c.slug));
const hasTeam = TEACHING_FELLOWS.length > 0 || TEACHING_ASSISTANTS.length > 0;
---

<Base
  title={COURSE_NAME}
  description="Interactive puzzles and course material for an undergraduate course in discrete mathematics."
>
  <section class="text-center pt-4 pb-14">
    <div style="color: var(--accent-deep)" class="flex justify-center mb-6">
      <Petersen width="104" />
    </div>
    <h1 class="display text-4xl font-bold tracking-tight mb-3">{COURSE_NAME}</h1>
    <p class="text-[var(--muted)] max-w-xl mx-auto leading-relaxed">
      {COURSE_SUBTITLE}. The puzzles below are the ones the companion text on induction
      is built from — play with them before you read the proofs, and the proofs will
      read like something you already suspected.
    </p>
  </section>

  <section class="mb-16">
    <h2 class="text-xs uppercase tracking-wider text-[var(--muted)] mb-3">Chapters</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      {
        chapters.map((c, i) => (
          <ChapterCard
            href={`${base}/${c.slug}/`}
            index={i + 1}
            title={c.title}
            blurb={c.blurb}
          />
        ))
      }
    </div>
    {
      chapters.length === 0 && (
        <p class="text-[var(--muted)] text-sm">Nothing has been released yet.</p>
      )
    }
  </section>

  <section class="grid sm:grid-cols-2 gap-8 mb-4">
    <div>
      <h2 class="text-xs uppercase tracking-wider text-[var(--muted)] mb-3">Instructor</h2>
      <p class="font-medium">{INSTRUCTOR}</p>
      {
        hasTeam && (
          <>
            {TEACHING_FELLOWS.length > 0 && (
              <>
                <h3 class="text-xs uppercase tracking-wider text-[var(--muted)] mt-4 mb-1.5">
                  Teaching fellows
                </h3>
                <ul class="text-sm space-y-0.5">
                  {TEACHING_FELLOWS.map((p) => <li>{p}</li>)}
                </ul>
              </>
            )}
            {TEACHING_ASSISTANTS.length > 0 && (
              <>
                <h3 class="text-xs uppercase tracking-wider text-[var(--muted)] mt-4 mb-1.5">
                  Teaching assistants
                </h3>
                <ul class="text-sm space-y-0.5">
                  {TEACHING_ASSISTANTS.map((p) => <li>{p}</li>)}
                </ul>
              </>
            )}
          </>
        )
      }
    </div>

    <div>
      <h2 class="text-xs uppercase tracking-wider text-[var(--muted)] mb-3">Office hours</h2>
      <div class="p-4 rounded-lg border border-[var(--rule)] bg-[var(--surface)] text-sm leading-relaxed">
        <p class="mb-2">
          My office is <span class="tabular-nums font-medium">{OFFICE}</span>. Walking in is
          the ordinary way to come — you do not need an appointment.
        </p>
        <p class="text-[var(--muted)]">
          If you would rather be sure I am there,
          <a href={BOOKING_URL} style="color: var(--accent)" class="underline">book a slot</a>;
          that only guarantees I am in the room at the time you pick.
        </p>
      </div>
    </div>
  </section>
</Base>
